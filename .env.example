BNET_CLIENT_ID=
BNET_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
REGION=us
LOCALE=en_US
POLL_INTERVAL_SECONDS=300
STATE_FILE_PATH=./data/state.json

# Minimum realm count change to trigger a Discord post (default: 10).
# Filters out minor flaps (e.g., 1-7 realms) while still alerting on maintenance (100+ realms).
# Set to 1 to post on any change (old behavior).
MIN_CHANGE_THRESHOLD=10

# Optional DNS overrides for the container (compose uses these if set)
# DNS1=192.168.1.1
# DNS2=8.8.8.8

# Optional: specify multiple Discord channels for automatic status updates (comma-separated)
# DISCORD_CHANNEL_IDS=123456789012345678,234567890123456789

# SLASH COMMANDS:
# The bot uses /realm slash commands that work in any channel where the bot has permissions.
# Users get private (ephemeral) responses when they use /realm commands.
# Automatic status updates still go to the channels specified above.
#
# BOT INVITATION:
# When inviting the bot to your server, make sure to include:
# - Send Messages (for status updates)
# - Use Slash Commands (for /realm command)
# - View Channels (to access channels)
